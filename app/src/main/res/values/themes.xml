<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pulsa" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/neon_border</item>
        <item name="colorError">@color/primary_red</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:seekBarStyle">@style/Widget.Pulsa.SeekBar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pulsa.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Pulsa.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.Pulsa.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/neon_border</item>
    </style>

    <style name="Theme.Pulsa.Blue" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorSecondary">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="Theme.Pulsa.Green" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorSecondary">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="Theme.Pulsa.Amber" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_amber</item>
        <item name="colorSecondary">@color/primary_amber_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="Theme.Pulsa.Red" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorSecondary">@color/primary_red_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="Theme.Pulsa.Pink" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_pink</item>
        <item name="colorSecondary">@color/primary_pink_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="Theme.Pulsa.Teal" parent="Theme.Pulsa">
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorSecondary">@color/primary_teal_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
    </style>

    <style name="ThemeOverlay.Pulsa.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Pulsa.BottomSheet</item>
    </style>

    <style name="Widget.Pulsa.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:backgroundTint">@color/surface</item>
    </style>

    <style name="Widget.Pulsa.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/bg_header_grad</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="CardPlayerMini" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/neon_border_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Pulsa.SeekBar" parent="@android:style/Widget.SeekBar">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/divider</item>
        <item name="android:thumbTint">@color/primary</item>
    </style>

    <style name="Widget.Pulsa.NeonButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Pulsa.Tab" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>