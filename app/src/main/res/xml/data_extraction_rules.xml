<?xml version="1.0" encoding="utf-8"?>
<!--
    Mesma regra do `backup_rules.xml` (Android 12+): o DataStore no domínio `files` viaja,
    enquanto conta, secrets e XMLs legados no domínio `sharedpref` ficam fora.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
