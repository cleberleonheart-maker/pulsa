<?xml version="1.0" encoding="utf-8"?>
<!--
    As preferências não sensíveis estão no DataStore, no domínio `files`, e viajam por padrão.
    Todo o domínio `sharedpref` fica fora: ele contém a conta, os secrets cifrados e os XMLs
    legados mantidos apenas como cópia local de recuperação.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
