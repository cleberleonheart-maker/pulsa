<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_mini_art_ring"
            android:clickable="false"
            android:focusable="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/mini_art"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_album_art"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:tint="@color/ic_placeholder"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                style="@style/TextAppearance.Pulsa.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/mini_artist"
                style="@style/TextAppearance.Pulsa.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/mini_shuffle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_repeat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_like"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_heart"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_virgin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_nucleus"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- Barra de progresso (cockpit) -->
    <View
        android:layout_width="120dp"
        android:layout_height="2dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_progress_mini" />
</FrameLayout>