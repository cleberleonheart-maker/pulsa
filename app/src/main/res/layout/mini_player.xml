<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mini_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_album_art"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:tint="@color/ic_placeholder"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                style="@style/TextAppearance.Pulsa.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/mini_artist"
                style="@style/TextAppearance.Pulsa.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/mini_shuffle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_repeat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_like"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_heart"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_virgin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/mini_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_play_btn"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>