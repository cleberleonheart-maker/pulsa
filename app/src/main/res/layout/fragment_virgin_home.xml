<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Herói "avatar no meio" estilo TAMI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_grad"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="16dp">

            <com.pulsa.player.ui.DancingVirginView
                android:id="@+id/hero_avatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/dj_voice_name"
                android:elevation="8dp" />

            <TextView
                android:id="@+id/hero_name"
                style="@style/TextAppearance.Pulsa.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/dj_voice_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bombar / Relaxar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_party"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_glow"
                android:gravity="center"
                android:text="@string/btn_party"
                android:textColor="#052630"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_relax"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_calm"
                android:gravity="center"
                android:text="@string/btn_relax"
                android:textColor="#052630"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cards de funções -->
        <LinearLayout
            android:id="@+id/cards_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/home_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/virgin_hub_note"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>