<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.pulsa.player.ui.MusicShaderView
            android:id="@+id/np_shader"
            android:layout_width="match_parent"
            android:layout_height="520dp"
            android:layout_gravity="top"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:gravity="center">

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/bg_glow"
                android:elevation="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="280dp"
                android:layout_height="280dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="16dp"
                app:strokeColor="@color/neon_border_soft"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/np_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_album_art"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/ic_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <com.pulsa.player.ui.DancingVirginView
                android:id="@+id/np_virgin_dance"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-12dp"
                android:layout_marginBottom="-4dp"
                android:contentDescription="@null"
                android:elevation="18dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/np_title"
            style="@style/TextAppearance.Pulsa.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/np_like"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_heart"
            android:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/np_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/np_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000" />

        <com.pulsa.player.ui.AudioVisualizerView
            android:id="@+id/np_visualizer"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/np_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text_secondary" />

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/np_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="@color/text_primary" />

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center">

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_glow" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/np_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/play"
                    app:backgroundTint="?attr/colorPrimary"
                    app:elevation="8dp"
                    app:fabCustomSize="72dp"
                    app:srcCompat="@drawable/ic_play"
                    app:tint="@color/on_primary" />
            </FrameLayout>

            <ImageView
                android:id="@+id/np_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/text_primary" />

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/np_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/np_add_playlist"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_to_playlist"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/np_sleep"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sleep_title"
                app:icon="@drawable/ic_sleep"
                app:iconTint="?attr/colorPrimary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

<com.google.android.material.button.MaterialButton
                android:id="@+id/np_ambient"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ambient_title"
                app:icon="@drawable/ic_ambient"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/np_eq"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eq_button"
                app:icon="@drawable/ic_settings"
                app:iconTint="?attr/colorPrimary" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/np_lyrics"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lyrics_button"
                app:icon="@drawable/ic_queue_music"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>