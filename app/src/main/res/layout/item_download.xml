<?xml version="1.0" encoding="utf-8"?>
<!--
    Linha da aba "Baixados". Repete o esqueleto de `item_video` (miniatura + título + meta +
    menu) porque é a mesma leitura: o que é, e o que dá para fazer com ele.

    A diferença é a barra de progresso, que só aparece quando o item está em andamento. Ela
    fica **debaixo** do texto e não no lugar da miniatura: durante o download a miniatura é
    um ícone de download estático e trocar os dois de lugar a cada 400 ms faria a linha
    "pular" a cada atualização.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_song_normal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_album_art"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/dl_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_download"
            app:tint="@color/surface_variant" />

        <ImageView
            android:id="@+id/dl_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@string/video_play"
            android:src="@drawable/ic_play_circle"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dl_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/dl_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressTint="@color/primary"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/dl_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more"
        android:padding="10dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/text_secondary" />
</LinearLayout>
