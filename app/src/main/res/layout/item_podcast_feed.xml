<?xml version="1.0" encoding="utf-8"?>
<!--
  F3 — linha da assinatura na aba Podcasts.

  A arte é remota (o feed publica a URL), então o ImageView não tem `src` fixo: quem preenche
  é o adapter, que cai no `ic_mic` enquanto o download não volta. O `ic_mic` é o ícone do
  microfone da Virgin e não um podcast — é o melhor "não é música" que o app já tem.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_song_normal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/feed_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_album_art"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_mic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/feed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/feed_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/feed_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/feed_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/feed_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/text_secondary" />
</LinearLayout>