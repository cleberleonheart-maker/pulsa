<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_strip_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/tab_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_virgin"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_virgin" />

        <TextView
            android:id="@+id/tab_songs"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_songs" />

        <TextView
            android:id="@+id/tab_albums"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_albums" />

        <TextView
            android:id="@+id/tab_artists"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_artists" />

        <TextView
            android:id="@+id/tab_favorites"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_favorites" />

        <TextView
            android:id="@+id/tab_videos"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_videos" />

        <TextView
            android:id="@+id/tab_playlists"
            style="@style/Widget.Pulsa.TabItem"
            android:text="@string/tab_playlists" />
    </LinearLayout>
</HorizontalScrollView>