<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="10dp" android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="45"
                android:endColor="#55C86BFF"
                android:startColor="#66FF2E9E" />
        </shape>
    </item>
    <item
        android:bottom="11dp"
        android:left="1dp"
        android:right="1dp"
        android:top="11dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="135"
                android:endColor="#120529"
                android:startColor="#20123F" />
        </shape>
    </item>
    <item android:bottom="28dp" android:top="28dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#30C86BFF"
                android:endColor="#00C86BFF"
                android:centerX="0.5"
                android:centerY="0.12"
                android:gradientRadius="120dp"
                android:startColor="#1EC86BFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>