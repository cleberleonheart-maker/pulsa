<?xml version="1.0" encoding="utf-8"?>
<!--
    Virgin. Mesma construcao do avatar do Lingo (src/constants/languages.ts, id
    "en"): esfera com o gradiente em 35% 28% -> 100% 100%, olho oval 13x16 com
    glint, bochecha e meio-sorriso, e piscada encolhendo o olho em scaleY
    (@animator/eye_blink) em vez de palpebra desenhada por cima.

    Paleta rosa/magenta, que e a do Lingo/TAMI — antes ela era roxa igual ao
    Victor e os dois viravam indistinguiveis de longe.

    Cabelo desenhado em path (o TAMI usa emoji 🎀/🧢, que VectorDrawable nao
    renderiza): franja com risco lateral e mechas longas. Fica acima da testa
    (y <= 44 nas laterais) para nao cobrir os olhos que piscam.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Halo de luz (bloom atras da cabeca) -->
    <path
        android:pathData="M50,60m-46,0a46,46 0 1 1 92,0a46,46 0 1 1 -92,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="46"
                android:startColor="#33FF6EC7"
                android:centerColor="#14FF8AD0"
                android:endColor="#00B388FF" />
        </aapt:attr>
    </path>

    <!-- Cabeca: esfera "por-do-sol" (rosa claro -> magenta -> violeta) -->
    <path
        android:pathData="M54,2a52,52 0 1 1 0,104a52,52 0 1 1 0,-104Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="0.34"
                android:centerY="0.26"
                android:gradientRadius="90"
                android:startColor="#FFE3F2"
                android:centerColor="#FF8AD0"
                android:endColor="#B388FF" />
        </aapt:attr>
    </path>

    <!-- Cabelo: franja com risco lateral e mechas longas emoldurando o rosto -->
    <path
        android:fillColor="#AD1457"
        android:pathData="M8,44 C6,22 26,4 54,4 C82,4 102,22 100,44 C96,34 92,30 86,30 C80,22 72,20 64,22 C58,28 50,30 42,26 C34,24 26,28 24,34 C18,32 12,36 8,44 Z" />
    <path
        android:fillColor="#AD1457"
        android:pathData="M8,44 C4,60 6,78 14,92 C18,82 20,70 18,58 C16,52 12,48 8,44 Z" />
    <path
        android:fillColor="#AD1457"
        android:pathData="M100,44 C104,60 102,78 94,92 C90,82 88,70 90,58 C92,52 96,48 100,44 Z" />
    <path
        android:fillColor="#E91E63"
        android:pathData="M28,30 C34,20 46,15 58,16 C50,20 44,25 40,32 C36,32 32,31 28,30 Z" />
    <path
        android:fillColor="#E91E63"
        android:pathData="M11,50 C9,60 10,72 14,82 C16,72 17,62 16,54 Z" />

    <!-- Estrela de 4 pontas no topo (sparkle) -->
    <path
        android:fillColor="#FFE9C4"
        android:pathData="M54,6 L57,15 L66,18 L57,21 L54,30 L51,21 L42,18 L51,15 Z" />

    <!-- Laco neon (mesma posicao do 🎀 do Lingo: 12° deitado, sangrando na direita) -->
    <group
        android:rotation="12"
        android:pivotX="85"
        android:pivotY="10">
        <path
            android:fillColor="#FF6EC7"
            android:pathData="M85,10C80,3 72,3 68,8C72,13 79,15 85,13Z" />
        <path
            android:fillColor="#FF6EC7"
            android:pathData="M85,10C90,3 98,3 102,8C98,13 91,15 85,13Z" />
        <path
            android:fillColor="#FF6EC7"
            android:pathData="M82,12L86,11L82,21L79,20Z" />
        <path
            android:fillColor="#FF6EC7"
            android:pathData="M87,11L90,12L91,21L88,22Z" />
        <path
            android:fillColor="#FFD3EC"
            android:pathData="M85,10m-3,0a3,3 0 1 1 6,0a3,3 0 1 1 -6,0Z" />
    </group>

    <!-- Olho esquerdo (13x16, centro 34.5,50) — encolhe em scaleY pra piscar -->
    <group
        android:name="eyeL"
        android:pivotX="34.5"
        android:pivotY="50">
        <path
            android:fillColor="#33113A"
            android:pathData="M34.5,50m-6.5,0a6.5,8 0 1 1 13,0a6.5,8 0 1 1 -13,0Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M32,45m-2.5,0a2.5,2.5 0 1 1 5,0a2.5,2.5 0 1 1 -5,0Z" />
    </group>

    <!-- Olho direito (centro 73.5,50) -->
    <group
        android:name="eyeR"
        android:pivotX="73.5"
        android:pivotY="50">
        <path
            android:fillColor="#33113A"
            android:pathData="M73.5,50m-6.5,0a6.5,8 0 1 1 13,0a6.5,8 0 1 1 -13,0Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M71,45m-2.5,0a2.5,2.5 0 1 1 5,0a2.5,2.5 0 1 1 -5,0Z" />
    </group>

    <!-- Bochechas -->
    <path
        android:fillColor="#8CFF378C"
        android:pathData="M25,63m-9,0a9,5 0 1 0 18,0a9,5 0 1 0 -18,0Z" />
    <path
        android:fillColor="#8CFF378C"
        android:pathData="M83,63m-9,0a9,5 0 1 0 18,0a9,5 0 1 0 -18,0Z" />

    <!-- Sorriso largo e curvo -->
    <path
        android:pathData="M44,65.5Q54,73 64,65.5"
        android:strokeColor="#33113A"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />

    <!-- Boca aberta do estado .playing: o grupo fica encolhido em scaleY 0
         (invisivel) e o animator mouth_talk abre/fecha no ritmo da fala. Fica
         por cima do sorriso e usa a mesma cor, entao fechado nao aparece. -->
    <group
        android:name="mouthOpen"
        android:pivotX="54"
        android:pivotY="70"
        android:scaleY="0">
        <path
            android:fillColor="#33113A"
            android:pathData="M45,65.5 C48,63.5 60,63.5 63,65.5 C63,71.5 59,76.5 54,76.5 C49,76.5 45,71.5 45,65.5 Z" />
    </group>
</vector>
