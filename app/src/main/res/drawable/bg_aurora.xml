<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal Radar · horizonte de varredura
     Céu de terminal (verde-escuro profundo), retículo de travação alvo,
     blips de radar (lima/rubi), grid de chão em perspectiva e linha de horizonte. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Céu de terminal: quase-preto no zênite -> verde-escuro -> brilho de horizonte -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/surface"
                android:endColor="@color/neon_border_soft"
                android:startColor="@color/glass_fill" />
        </shape>
    </item>

    <!-- 2. Névoas de varredura (profundidade atmosférica) -->
    <item
        android:gravity="left|top"
        android:left="-40dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/orbit_cyan"
                android:endColor="@color/aurora_cyan_a00"
                android:gradientRadius="240dp"
                android:startColor="@color/aurora_cyan_a0F"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="right|top"
        android:right="-40dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_rose_a20"
                android:endColor="@color/aurora_rose_a00"
                android:gradientRadius="230dp"
                android:startColor="@color/aurora_rose_a10"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="left|top"
        android:left="140dp"
        android:top="120dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_violet_a14"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="120dp"
                android:startColor="@color/aurora_violet_a08"
                android:type="radial" />
        </shape>
    </item>

    <!-- 3. Retículo de travação (anel trave sobre o horizonte) -->
    <item
        android:bottom="-90dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/aurora_violet_a40" />
            <size
                android:width="264dp"
                android:height="264dp" />
        </shape>
    </item>
    <item
        android:bottom="-14dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/aurora_rose_a1F" />
            <size
                android:width="344dp"
                android:height="344dp" />
        </shape>
    </item>

    <!-- 4. Blips de radar (alvos detectados) -->
    <item
        android:bottom="210dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_violet_a99"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="8dp"
                android:startColor="@color/aurora_violet_a4D"
                android:type="radial" />
            <size
                android:width="18dp"
                android:height="18dp" />
        </shape>
    </item>
    <item
        android:bottom="120dp"
        android:gravity="bottom|left"
        android:left="44dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_rose_aB3"
                android:endColor="@color/aurora_rose_a00"
                android:gradientRadius="7dp"
                android:startColor="@color/aurora_rose_a59"
                android:type="radial" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <item
        android:bottom="270dp"
        android:gravity="bottom|right"
        android:right="60dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/white_a80"
                android:endColor="@color/white_a00"
                android:gradientRadius="5dp"
                android:startColor="@color/white_a33"
                android:type="radial" />
            <size
                android:width="12dp"
                android:height="12dp" />
        </shape>
    </item>

    <!-- 5. Horizonte: risco lima + eco rubi -->
    <item
        android:bottom="16dp"
        android:gravity="bottom|center_horizontal"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_violet"
                android:endColor="@color/aurora_violet_a73"
                android:startColor="@color/aurora_violet_a73" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:gravity="bottom|center_horizontal"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_rose_a59"
                android:endColor="@color/aurora_rose_a26"
                android:startColor="@color/aurora_rose_a26" />
            <size android:height="1dp" />
        </shape>
    </item>

    <!-- 6. Linha de varredura propagando do horizonte (glow) -->
    <item
        android:bottom="40dp"
        android:gravity="bottom|center_horizontal"
        android:left="60dp"
        android:right="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_violet_a62"
                android:endColor="@color/aurora_violet_a14"
                android:startColor="@color/aurora_violet_a14" />
            <size android:height="1dp" />
        </shape>
    </item>

    <!-- 7. Chão: asfalto do grid -->
    <item
        android:bottom="0dp"
        android:gravity="fill_horizontal|bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/bg_elev"
                android:endColor="@color/bg"
                android:startColor="@color/neon_border_soft" />
            <size android:height="22dp" />
        </shape>
    </item>

    <!-- 8. Grid de chão em perspectiva (varredura lima) -->
    <item
        android:bottom="18dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_violet_a22" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item
