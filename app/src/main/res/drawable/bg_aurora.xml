<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsar Neon · synthwave cinematográfico
     Poente retrô com luz volumétrica, brilho atmosférico e grid de chão em perspectiva. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Céu profundo (atmosfera: quase-preto no topo -> púrpura -> rosa-cerrado no horizonte) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#22083F"
                android:endColor="#7A2662"
                android:startColor="#08011A" />
        </shape>
    </item>

    <!-- 2. Nébulas suaves do topo (profundidade) -->
    <item
        android:gravity="left|top"
        android:left="-40dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#22C86BFF"
                android:endColor="#00C86BFF"
                android:gradientRadius="240dp"
                android:startColor="#0FC86BFF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="right|top"
        android:right="-40dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#2025F4EE"
                android:endColor="#0025F4EE"
                android:gradientRadius="230dp"
                android:startColor="#1025F4EE"
                android:type="radial" />
        </shape>
    </item>

    <!-- 3. Brilho volumétrico do sol (bloom) cortando o céu -->
    <item
        android:bottom="-80dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#33FF7A3D"
                android:endColor="#00FF7A3D"
                android:gradientRadius="300dp"
                android:startColor="#14FF7A3D"
                android:type="radial" />
        </shape>
    </item>

