        android:right="204dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_violet_a1C" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item
        android:bottom="262dp"
        android:left="278dp"
        android:right="278dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_violet_a16" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item
        android:bottom="346dp"
        android:left="364dp"
        android:right="364dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_violet_a12" />
            <size android:height="1dp" />
        </shape>
    </item>
    <item
        android:bottom="448dp"
        android:left="466dp"
        android:right="466dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_violet_a0E" />
            <size android:height="1dp" />
        </shape>
    </item>

    <!-- 9. Poeira estelar (pontos discretos de sinal) -->
    <item
        android:gravity="left|top"
        android:left="42dp"
        android:top="52dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/white_a99"
                android:endColor="@color/white_a00"
