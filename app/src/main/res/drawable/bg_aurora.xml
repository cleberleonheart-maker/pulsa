        </shape>
    </item>
    <item
        android:gravity="right|top"
        android:right="54dp"
        android:top="34dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_violet_a80"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="3dp"
                android:startColor="@color/aurora_violet_a26"
                android:type="radial" />
            <size
                android:width="9dp"
                android:height="9dp" />
        </shape>
    </item>
    <item
        android:gravity="left|top"
        android:left="120dp"
        android:top="22dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_pink_a66"
                android:endColor="@color/aurora_pink_a00"
