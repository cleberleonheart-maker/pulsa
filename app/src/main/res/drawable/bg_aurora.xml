    <!-- 5. Névoa atmosférica sobre o horizonte (espalha a luz do poente) -->
    <item
        android:bottom="0dp"
        android:gravity="fill_horizontal|bottom"
        android:left="-40dp"
        android:right="-40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#2E8A2A66"
                android:endColor="#218A2A66"
                android:startColor="#3D8A2A66" />
            <size android:height="88dp" />
        </shape>
    </item>

    <!-- 6. Linha de luz do horizonte (reflexo do poente) -->
    <item
        android:bottom="16dp"
        android:gravity="bottom|center_horizontal"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#B3FF6A5A"
                android:endColor="#5925F4EE"
                android:startColor="#59FFC84D" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- 7. Chão: gradiente do asfalto noturno (fundo do grid) -->
    <item
