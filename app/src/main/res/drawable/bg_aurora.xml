<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Espaço profundo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>

    <!-- Nébula violeta central -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.48"
                android:centerY="0.42"
                android:centerColor="#22B388FF"
                android:endColor="#00B388FF"
                android:gradientRadius="0.95"
                android:startColor="#14B388FF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Nébula magenta p/ canto superior direito -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.88"
                android:centerY="0.04"
                android:centerColor="#1C00E5FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="0.72"
                android:startColor="#1400E5FF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Nébula ciano p/ canto inferior esquerdo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.04"
                android:centerY="0.96"
                android:centerColor="#1A00E5FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="0.8"
                android:startColor="#1200E5FF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Núcleo de brilho magenta -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.94"
                android:centerY="0.14"
                android:centerColor="#2600E5FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="0.3"
                android:startColor="#1A00E5FF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Anel do planeta (Saturno) — atrás do corpo -->
    <item
        android:bottom="78dp"
        android:gravity="bottom|right"
        android:right="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:centerColor="#4D46D6FF"
                android:endColor="#1A00E5FF"
                android:startColor="#20B388FF" />
            <stroke
                android:width="1dp"
                android:color="#8046D6FF" />
            <size
                android:width="120dp"
                android:height="34dp" />
        </shape>
    </item>

    <!-- Corpo do planeta na borda inferior direita -->
    <item
        android:bottom="70dp"
        android:gravity="bottom|right"
        android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#FF161E41" />
            <stroke
                android:width="1dp"
                android:color="#4000E5FF" />
            <size
                android:width="82dp"
                android:height="82dp" />
        </shape>
    </item>

    <!-- Iluminação de terminador do planeta -->
    <item
        android:bottom="71dp"
        android:gravity="bottom|right"
        android:right="11dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.28"
                android:centerY="0.2"
                android:centerColor="#662C4978"
                android:endColor="#000F1632"
                android:gradientRadius="41dp"
                android:startColor="#99425C88"
                android:type="radial" />
            <size
                android:width="80dp"
                android:height="80dp" />
        </shape>
    </item>

    <!-- Reflexo specular no planeta -->
    <item
        android:bottom="124dp"
        android:gravity="bottom|right"
        android:right="24dp">
        <shape android:shape="oval">
            <solid android:color="#3DFFF0DF" />
            <size
                android:width="16dp"
                android:height="7dp" />
        </shape>
    </item>

    <!-- Lua pequena no canto superior esquerdo -->
    <item
        android:gravity="left|top"
        android:left="16dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="#22FFF0DF" />
            <size
                android:width="36dp"
                android:height="36dp" />
        </shape>
    </item>

    <item
        android:gravity="left|top"
        android:left="20dp"
        android:top="19dp">
        <shape android:shape="oval">
            <solid android:color="#B3FFF0DF" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <item
        android:gravity="left|top"
        android:left="29dp"
        android:top="23dp">
        <shape android:shape="oval">
            <solid android:color="#79CFB8D2" />
            <size
                android:width="9dp"
                android:height="9dp" />
        </shape>
    </item>
</layer-list>