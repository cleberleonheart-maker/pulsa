<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal Radar · horizonte de varredura
     Céu de terminal (verde-escuro profundo), retículo de travação alvo,
     blips de radar (lima/rubi), grid de chão em perspectiva e linha de horizonte. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Céu de terminal: quase-preto no zênite -> verde-escuro -> brilho de horizonte -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#0A2112"
                android:endColor="#15331E"
                android:startColor="#04100A" />
        </shape>
    </item>

    <!-- 2. Névoas de varredura (profundidade atmosférica) -->
    <item
        android:gravity="left|top"
        android:left="-40dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#22A8E62A"
                android:endColor="#00A8E62A"
                android:gradientRadius="240dp"
                android:startColor="#0FA8E62A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="right|top"
        android:right="-40dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#20FF2E4D"
                android:endColor="#00FF2E4D"
                android:gradientRadius="230dp"
                android:startColor="#10FF2E4D"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="left|top"
        android:left="140dp"
        android:top="120dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#14B6FF2E"
                android:endColor="#00B6FF2E"
                android:gradientRadius="120dp"
                android:startColor="#08B6FF2E"
                android:type="radial" />
        </shape>
    </item>

    <!-- 3. Retículo de travação (anel trave sobre o horizonte) -->
    <item
        android:bottom="-90dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#40B6FF2E" />
            <size
                android:width="264dp"
                android:height="264dp" />
        </shape>
    </item>
    <item
        android:bottom="-14dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#1FFF2E4D" />
            <size
                android:width="344dp"
                android:height="344dp" />
        </shape>
    </item>

    <!-- 4. Blips de radar (alvos detectados) -->
    <item
        android:bottom="210dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#99B6FF2E"
                android:endColor="#00B6FF2E"
                android:gradientRadius="8dp"
                android:startColor="#4DB6FF2E"
                android:type="radial" />
            <size
                android:width="18dp"
                android:height="18dp" />
        </shape>
    </item>
    <item
        android:bottom="120dp"
        android:gravity="bottom|left"
        android:left="44dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#B3FF2E4D"
                android:endColor="#00FF2E4D"
                android:gradientRadius="7dp"
                android:startColor="#59FF2E4D"
                android:type="radial" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <item
        android:bottom="270dp"
        android:gravity="bottom|right"
        android:right="60dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:gradientRadius="5dp"
                android:startColor="#33FFFFFF"
                android:type="radial" />
            <size
                android:width="12dp"
                android:height="12dp" />
        </shape>
    </item>

    <!-- 5. Horizonte: risco lima + eco rubi -->
    <item
        android:bottom="16dp"
        android:gravity="bottom|center_horizontal"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#FFB6FF2E"
                android:endColor="#73B6FF2E"
                android:startColor="#73B6FF2E" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:gravity="bottom|center_horizontal"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#59FF2E4D"
                android:endColor="#26FF2E4D"
                android:startColor="#26FF2E4D" />
            <size android:height="1dp" />
        </shape>
    </item>

    <!-- 6. Linha de varredura propagando do horizonte (glow) -->
    <item
        android:bottom="40dp"
        android:gravity="bottom|center_horizontal"
        android:left="60dp"
        android:right="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#62B6FF2E"
                android:endColor="#14B6FF2E"
                android:startColor="#14B6FF2E" />
            <size android:height="1dp" />
        </shape>
    </item>

    <!-- 7. Chão: asfalto do grid -->
    <item
        android:bottom="0dp"
        android:gravity="fill_horizontal|bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#0C1C13"
                android:endColor="#06100B"
                android:startColor="#15331E" />
            <size android:height="22dp" />
        </shape>
    </item>

    <!-- 8. Grid de chão em perspectiva (varredura lima) -->
    <item
        android:bottom="18dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22B6FF2E" />
            <size android:height="1dp" />
        </shape>
    </item>
