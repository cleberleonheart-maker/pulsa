<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Pod chanfrado (chassis radar) -->
    <item>
        <com.pulsa.player.ui.RadarPanelDrawable
            app:panelColor="#F00C1C13"
            app:panelCut="12dp"
            app:panelStroke="#59B6FF2E"
            app:panelStrokeWidth="1dp" />
    </item>

    <!-- Linha de energia superior -->
    <item
        android:gravity="top"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#CCFF2E4D"
                android:startColor="#99FF6A7A" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Farol esquerdo -->
    <item
        android:bottom="24dp"
        android:gravity="left|center_vertical"
        android:left="6dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#B3B6FF2E" />
            <size
                android:width="4dp"
                android:height="4dp" />
        </shape>
    </item>

    <!-- Farol direito -->
    <item
        android:bottom="24dp"
        android:gravity="right|center_vertical"
        android:right="6dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#B3B6FF2E" />
            <size
                android:width="4dp"
                android:height="4dp" />
        </shape>
    </item>
</layer-list>