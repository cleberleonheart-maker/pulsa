<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Corpo da cápsula -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#F01B0B34" />
        </shape>
    </item>

    <!-- Contorno néon -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#5925F4EE" />
        </shape>
    </item>

    <!-- Linha de energia superior -->
    <item
        android:gravity="top"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#CCFF2E9E"
                android:startColor="#99FF6BC4" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Farol esquerdo -->
    <item
        android:bottom="24dp"
        android:gravity="left|center_vertical"
        android:left="6dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#B325F4EE" />
            <size
                android:width="4dp"
                android:height="4dp" />
        </shape>
    </item>

    <!-- Farol direito -->
    <item
        android:bottom="24dp"
        android:gravity="right|center_vertical"
        android:right="6dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#B325F4EE" />
            <size
                android:width="4dp"
                android:height="4dp" />
        </shape>
    </item>
</layer-list>