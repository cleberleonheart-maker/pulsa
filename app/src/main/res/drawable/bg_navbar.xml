<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Barra estreita translúcida -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/violet_deep_a66" />
        </shape>
    </item>

    <!-- Linha néon inferior (holográfico) -->
    <item
        android:bottom="0dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_rose_aB3"
                android:endColor="@color/aurora_violet_aB3"
                android:startColor="@color/aurora_violet_aB3" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>