<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Barra estreita translúcida -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#661A0B34" />
        </shape>
    </item>

    <!-- Linha néon inferior (holográfico) -->
    <item
        android:bottom="0dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#B3FF2E9E"
                android:endColor="#B325F4EE"
                android:startColor="#B3FFC84D" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>