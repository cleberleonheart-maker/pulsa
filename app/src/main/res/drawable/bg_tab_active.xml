<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:centerColor="#66FF6BC4"
                android:endColor="#4025F4EE"
                android:startColor="#2EFF2E9E" />
            <stroke
                android:width="1dp"
                android:color="#5925F4EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#141A0B34" />
        </shape>
    </item>
</selector>