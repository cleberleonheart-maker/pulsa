<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:centerColor="#5900E5FF"
                android:endColor="#2600E5FF"
                android:startColor="#33B388FF" />
            <stroke
                android:width="1dp"
                android:color="#5900E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#14141A3A" />
        </shape>
    </item>
</selector>