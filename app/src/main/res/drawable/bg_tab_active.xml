<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:centerColor="#66FF6A7A"
                android:endColor="#40B6FF2E"
                android:startColor="#2EFF2E4D" />
            <stroke
                android:width="1dp"
                android:color="#59B6FF2E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#141A0B34" />
        </shape>
    </item>
</selector>