<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_pink_a66"
                android:endColor="@color/aurora_violet_a40"
                android:startColor="@color/aurora_rose_a2E" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_violet_a59" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/violet_deep_a14" />
        </shape>
    </item>
</selector>