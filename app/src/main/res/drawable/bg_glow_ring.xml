<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#663CE4FF"
                android:endColor="#00FF2E9E"
                android:gradientRadius="120dp"
                android:startColor="#B3FF2E9E"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#598A5CFF"
                android:endColor="#003CE4FF"
                android:gradientRadius="60dp"
                android:startColor="#2E3CE4FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>