<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59B6FF2E"
                android:endColor="#00B6FF2E"
                android:gradientRadius="120dp"
                android:startColor="#99B6FF2E"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59A8E62A"
                android:endColor="#00B6FF2E"
                android:gradientRadius="60dp"
                android:startColor="#2EB6FF2E"
                android:type="radial" />
        </shape>
    </item>
</layer-list>