<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#668A7CFB"
                android:endColor="#008A7CFB"
                android:gradientRadius="120dp"
                android:startColor="#B38A7CFB"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#592FD8E8"
                android:endColor="#002FD8E8"
                android:gradientRadius="60dp"
                android:startColor="#2E2FD8E8"
                android:type="radial" />
        </shape>
    </item>
</layer-list>