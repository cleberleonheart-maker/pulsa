<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59FFC84D"
                android:endColor="#00FFC84D"
                android:gradientRadius="120dp"
                android:startColor="#99FFC84D"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59C86BFF"
                android:endColor="#0025F4EE"
                android:gradientRadius="60dp"
                android:startColor="#2E25F4EE"
                android:type="radial" />
        </shape>
    </item>
</layer-list>