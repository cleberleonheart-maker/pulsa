<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#6600E5FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="120dp"
                android:startColor="#B300E5FF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59B388FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="60dp"
                android:startColor="#2E00E5FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>