<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_violet_a59"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="120dp"
                android:startColor="@color/aurora_violet_a99"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_cyan_a59"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="60dp"
                android:startColor="@color/aurora_violet_a2E"
                android:type="radial" />
        </shape>
    </item>
</layer-list>