<?xml version="1.0" encoding="utf-8"?>
<!-- Deck radar: vidro chanfrado + contorno lima + linha de energia + traços HUD -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Base chanfrada (chassis radar) -->
    <item>
        <com.pulsa.player.ui.PanelCutDrawable
            app:panelColor="@color/bg_elev_aF0"
            app:panelCut="14dp"
            app:panelStroke="@color/aurora_violet_a3D"
            app:panelStrokeWidth="1dp" />
    </item>

    <!-- Linha de energia superior -->
    <item
        android:gravity="top"
        android:left="20dp"
        android:right="20dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_pink_a66"
                android:endColor="@color/hud_grid"
                android:startColor="@color/aurora_rose_a2F" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Traços HUD inferiores -->
    <item
        android:bottom="10dp"
        android:gravity="bottom|left"
        android:left="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_tick" />
            <size
                android:width="26dp"
                android:height="4dp" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:gravity="bottom|right"
        android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_tick" />
            <size
                android:width="26dp"
                android:height="4dp" />
        </shape>
    </item>
</layer-list>