<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Corpo chanfrado (chassis radar) -->
    <item>
        <com.pulsa.player.ui.RadarPanelDrawable
            app:panelColor="#F008150E"
            app:panelCut="14dp"
            app:panelStroke="#46B6FF2E"
            app:panelStrokeWidth="1dp" />
    </item>

    <!-- Linha superior holográfica -->
    <item
        android:gravity="top"
        android:left="46dp"
        android:right="46dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#66FF6A7A"
                android:endColor="#26B6FF2E"
                android:startColor="#26FF2E4D" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Farol esquerdo (lima) -->
    <item
        android:bottom="26dp"
        android:gravity="left|center_vertical"
        android:left="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#AAB6FF2E"
                android:endColor="#00B6FF2E"
                android:gradientRadius="12dp"
                android:startColor="#FFB6FF2E"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <!-- Farol direito (rubi) -->
    <item
        android:bottom="26dp"
        android:gravity="right|center_vertical"
        android:right="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#AAFF2E4D"
                android:endColor="#00FF2E4D"
                android:gradientRadius="12dp"
                android:startColor="#FFFF6A7A"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>