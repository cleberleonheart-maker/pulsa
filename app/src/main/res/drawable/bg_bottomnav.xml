<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Corpo da pílula (vidro escuro) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#EE120529" />
        </shape>
    </item>

    <!-- Contorno néon -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="#4625F4EE" />
        </shape>
    </item>

    <!-- Linha superior holográfica -->
    <item
        android:gravity="top"
        android:left="46dp"
        android:right="46dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#66FF6BC4"
                android:endColor="#2625F4EE"
                android:startColor="#26FF2E9E" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Farol esquerdo (ciano) -->
    <item
        android:bottom="26dp"
        android:gravity="left|center_vertical"
        android:left="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#AA25F4EE"
                android:endColor="#0025F4EE"
                android:gradientRadius="12dp"
                android:startColor="#FF25F4EE"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <!-- Farol direito (magenta) -->
    <item
        android:bottom="26dp"
        android:gravity="right|center_vertical"
        android:right="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#AAFF2E9E"
                android:endColor="#00FF2E9E"
                android:gradientRadius="12dp"
                android:startColor="#FFFF6BC4"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>