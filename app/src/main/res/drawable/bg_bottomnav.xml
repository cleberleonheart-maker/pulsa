<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Corpo chanfrado (chassis radar) -->
    <item>
        <com.pulsa.player.ui.PanelCutDrawable
            app:panelColor="@color/surface_aF0"
            app:panelCut="14dp"
            app:panelStroke="@color/aurora_violet_a46"
            app:panelStrokeWidth="1dp" />
    </item>

    <!-- Linha superior holográfica -->
    <item
        android:gravity="top"
        android:left="46dp"
        android:right="46dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/aurora_pink_a66"
                android:endColor="@color/aurora_violet_a26"
                android:startColor="@color/aurora_rose_a26" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Farol esquerdo (lima) -->
    <item
        android:bottom="26dp"
        android:gravity="left|center_vertical"
        android:left="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_violet_aAA"
                android:endColor="@color/aurora_violet_a00"
                android:gradientRadius="12dp"
                android:startColor="@color/aurora_violet"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <!-- Farol direito (rubi) -->
    <item
        android:bottom="26dp"
        android:gravity="right|center_vertical"
        android:right="18dp"
        android:top="26dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_rose_aAA"
                android:endColor="@color/aurora_rose_a00"
                android:gradientRadius="12dp"
                android:startColor="@color/aurora_pink"
                android:type="radial" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>