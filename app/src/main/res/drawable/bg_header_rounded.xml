<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base violeta → ciano → magenta, base arredondada -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/neon_red_a33"
                android:endColor="@color/neon_lime_a26"
                android:startColor="@color/neon_green_aB3" />
        </shape>
    </item>

    <!-- Linha néon inferior (grid holográfico) -->
    <item
        android:bottom="0dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/neon_red_aB3"
                android:endColor="@color/neon_green_aB3"
                android:startColor="@color/neon_green_aB3" />
            <size android:height="2dp" />
        </shape>
    </item>

    <!-- Traços HUD inferiores -->
    <item
        android:bottom="8dp"
        android:gravity="bottom|left"
        android:left="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_tick" />
            <size
                android:width="24dp"
                android:height="4dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:gravity="bottom|right"
        android:right="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_tick" />
            <size
                android:width="24dp"
                android:height="4dp" />
        </shape>
    </item>

    <!-- Linhas verticais de varredura (HUD) no canto superior direito -->
    <item
        android:gravity="top|end"
        android:right="20dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_grid" />
            <size
                android:width="2dp"
                android:height="34dp" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:right="27dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_grid" />
            <size
                android:width="2dp"
                android:height="22dp" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:right="33dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_grid" />
            <size
                android:width="2dp"
                android:height="42dp" />
        </shape>
    </item>
</layer-list>