<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior do núcleo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_rose_a66"
                android:endColor="@color/aurora_rose_a00"
                android:gradientRadius="30dp"
                android:startColor="@color/aurora_pink_aB3"
                android:type="radial" />
        </shape>
    </item>
    <!-- Halo ciano intermediário -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="@color/aurora_cyan_a59"
                android:endColor="@color/aurora_cyan_a00"
                android:gradientRadius="18dp"
                android:startColor="@color/aurora_cyan_a8A"
                android:type="radial" />
        </shape>
    </item>
    <!-- Núcleo sólido -->
    <item
        android:bottom="13dp"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/accent_ice"
                android:startColor="@color/aurora_violet" />
        </shape>
    </item>
</layer-list>