<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior do núcleo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#5900E5FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="30dp"
                android:startColor="#B300E5FF"
                android:type="radial" />
        </shape>
    </item>
    <!-- Halo ciano intermediário -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59B388FF"
                android:endColor="#0000E5FF"
                android:gradientRadius="18dp"
                android:startColor="#8AB388FF"
                android:type="radial" />
        </shape>
    </item>
    <!-- Núcleo sólido -->
    <item
        android:bottom="13dp"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#46D6FF"
                android:startColor="#00E5FF" />
        </shape>
    </item>
</layer-list>