<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior do núcleo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#66FF2E4D"
                android:endColor="#00FF2E4D"
                android:gradientRadius="30dp"
                android:startColor="#B3FF6A7A"
                android:type="radial" />
        </shape>
    </item>
    <!-- Halo ciano intermediário -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#59A8E62A"
                android:endColor="#00A8E62A"
                android:gradientRadius="18dp"
                android:startColor="#8AA8E62A"
                android:type="radial" />
        </shape>
    </item>
    <!-- Núcleo sólido -->
    <item
        android:bottom="13dp"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#D9F6FF"
                android:startColor="#B6FF2E" />
        </shape>
    </item>
</layer-list>