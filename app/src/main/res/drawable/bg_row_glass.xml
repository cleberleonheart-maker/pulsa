<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#338A7CFB">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="45"
                        android:endColor="#402FD8E8"
                        android:startColor="#408A7CFB" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="17dp" />
                    <solid android:color="@color/glass_fill" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>