<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#33FF2E9E" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FF6BC4" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#30FF2E9E" />
            <stroke
                android:width="1.5dp"
                android:color="#8CFF6BC4" />
        </shape>
    </item>
</selector>