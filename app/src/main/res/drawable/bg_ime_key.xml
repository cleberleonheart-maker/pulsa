<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/aurora_violet"
                android:startColor="@color/primary_dark" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/primary_light" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/surface_variant"
                android:startColor="@color/glass_fill_strong" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/surface_variant"
                android:startColor="@color/glass_fill" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/neon_border" />
        </shape>
    </item>
</selector>
