<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#26FF2E9E" />
            <stroke
                android:width="1dp"
                android:color="#7000FFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/panel_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/panel_border" />
        </shape>
    </item>
</selector>