<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Tocar na TV (item 290): o SSDP do servidor DLNA é multicast, e o Wi-Fi do
         Android filtra multicast por padrão — sem CHANGE_WIFI_MULTICAST_STATE o
         M-SEARCH da Roku Media Player nunca chega e o servidor "Pulsa" não aparece. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Ouvir juntos: ler o QR do código da sessão no convidado. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Central multimídia: TV leanback. `required="false"` porque o app é primeiro
         de celular — o TV ganha o launcher extra sem afastar quem não tem TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- F4: Android Automotive OS (head unit com Android embutido). `required="false"` de
         propósito: o mesmo APK instala no celular e nos carros. O Google recomenda um APK
         separado porque o requisito `true` filtraria os celulares — aqui o app é primeiro de
         celular, então declara a capacidade sem se fechar. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".PulsaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Pulsa">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.pulsa.player.cast.PulsaCastOptionsProvider" />

        <!-- F4: Android Auto — declara o app como player de mídia. O carro descobre o
             `PlaybackService` (`MediaLibraryService`) a partir daqui. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Wear OS: o `WearableListenerService` abaixo recebe os comandos pelo Data Layer.
             O valor vem do play-services-base (já puxado pelo login do Google). -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- F5: atalhos estáticos de tela inicial (long-press no ícone). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- TV: o mesmo MainActivity, launcher leanback. Sem activity nova — o
                 engine já é Media3 e a UI reage a D-pad/remote por padrão nos botões. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DjActivity"
            android:exported="false" />

        <activity
            android:name=".DriveActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".KaraokeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".RadioActivity"
            android:exported="false" />

        <activity
            android:name=".TamiRadioActivity"
            android:exported="false" />

        <activity
            android:name=".BanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity
            android:name=".RewindActivity"
            android:exported="false" />

        <activity
            android:name=".VideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="false" />

        <activity
            android:name=".NowPlayingActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait" />

        <service
            android:name=".media.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!-- E6: sem estes intent-filters o serviço não aparece em "Fontes de mídia" do
                 sistema e o Assistant não acha faixa nenhuma. `MediaLibraryService` (herda de
                 `MediaBrowserService`) precisa das duas actions. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Wear OS: o relógio não vê a sessão Media3 do celular por Bluetooth; os
             comandos chegam pelo Data Layer e este serviço acorda o app mesmo fechado.
             `exported=true` é exigência do `WearableListenerService` (quem entrega a
             mensagem é o Google Play Services, em outro processo). O filtro de path
             impede que outro app use este serviço como ponte. -->
        <service
            android:name=".wear.WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/pulsa" />
            </intent-filter>
        </service>

        <service
            android:name=".util.UpdateService"
            android:exported="false" />

        <service
            android:name=".dj.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    <receiver
            android:name=".util.InstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.PulsaWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsa_widget_info" />
        </receiver>
    </application>
</manifest>